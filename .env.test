# ── TEST BACKENDS ────────────────────────────────────────────────────────────
# Loaded ONLY by `npm run dev:test` (Vite `--mode test`). A normal `npm run dev`
# and `npm run wf:bundle` read `.env` and never see this file, so test URLs
# cannot reach a submission bundle.
#
# Test worker = the DEFAULT env of consent-manager/ (`wrangler deploy` with no
# --env). Production is `manager.consentbit.com`, deployed with
# `wrangler deploy --env production`. Both share the same D1 databases but have
# SEPARATE CHECKOUT_TOKENS KV namespaces, so a token minted on one worker cannot
# be read by the other — all three URLs below must move together.

# consent-manager Worker API (OAuth/status, banner, scan, /api/wf/* auth routes).
VITE_WORKER_BASE_URL=https://consent-webapp-manager.web-8fb.workers.dev
# Worker that mints the checkout token + holds Stripe (TEST keys on this one).
VITE_CHECKOUT_API_BASE_URL=https://consent-webapp-manager.web-8fb.workers.dev
# Front-end that hosts the /checkout-plan page — the Test webapp build.
#
# MUST be consentbit-webapp-frontend-test. Verified 2026-09-18 by minting a token
# on the Test worker and exchanging it through each Pages project:
#   consentbit-webapp-frontend-test.pages.dev → Test worker   ✅ token resolves
#   consentbitfrontend.pages.dev              → PRODUCTION    ❌ always "expired"
# The page exchanges ?t= through its own /api/checkout-token proxy, which uses that
# project's PRODUCTION_API_BASE. The two workers have separate CHECKOUT_TOKENS KV
# namespaces, so a mismatch shows as "Checkout link expired" on every fresh click.
# (consentbitfrontend is what wrangler.toml's WEBAPP_PUBLIC_URL points at, but that
# var is only for emailed links — it is NOT the API base.)
VITE_CHECKOUT_BASE_URL=https://consentbit-webapp-frontend-test.pages.dev

# OAuth only: Webflow accepts the callback registered on the App, and only the
# production one is. Everything else stays on the test worker; the token lands in the
# shared D1 + KV, so the test worker sees the site as authorized.
VITE_OAUTH_BASE_URL=https://manager.consentbit.com
