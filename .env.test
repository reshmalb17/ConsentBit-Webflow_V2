# PRODUCTION MIRROR of the dev app's .env.test.
#
# This folder is the production copy: every URL here points at production, so no build
# from this folder can ever reach a test backend — not even `npm run dev:test` or
# `npm run wf:bundle:test`, which read this file.
#
# The dev folder (Consentbit-Webflow-App-New -Design) is where test URLs live.

# consent-manager Worker API (OAuth/status, banner, scan, /api/wf/* auth routes).
VITE_WORKER_BASE_URL=https://manager.consentbit.com
# Worker that mints the checkout token + holds Stripe.
VITE_CHECKOUT_API_BASE_URL=https://manager.consentbit.com
# Front-end that hosts the /checkout-plan page.
VITE_CHECKOUT_BASE_URL=https://accounts.consentbit.com
# OAuth authorize. In the dev folder this points at production because only the
# production callback is registered on the Webflow App; here it is production anyway.
VITE_OAUTH_BASE_URL=https://manager.consentbit.com
