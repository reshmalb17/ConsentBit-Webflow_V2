# ── TESTING (points the extension at the TEST worker + TEST checkout) ──────────
#    Uncomment this block (and comment the PRODUCTION block below) to test.
# VITE_WORKER_BASE_URL=https://consent-webapp-manager.web-8fb.workers.dev
# VITE_CHECKOUT_API_BASE_URL=https://consent-webapp-manager.web-8fb.workers.dev
# VITE_CHECKOUT_BASE_URL=https://consentbit-webapp-frontend-test.pages.dev

# ── PRODUCTION (ACTIVE — matches webflow.json dataConnections for submission) ──
# consent-manager Worker API (OAuth/status, banner, scan, /api/wf/* auth routes).
VITE_WORKER_BASE_URL=https://manager.consentbit.com
# Worker that mints the checkout token + holds Stripe.
VITE_CHECKOUT_API_BASE_URL=https://manager.consentbit.com
# Front-end that hosts the /checkoutplan page.
VITE_CHECKOUT_BASE_URL=https://accounts.consentbit.com
